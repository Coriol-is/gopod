# Untrusted group commands only: no provider CLI, credentials, private tools or
# network services. Runtime supplies readonly root, network=none, tmpfs workspace,
# hard process/address-space ceilings and no host bind mounts.
FROM debian:bookworm-slim
LABEL org.gopod.profile="group-tools" org.gopod.native-policy="group-boundary-v1"
RUN mkdir -p /workspace/chat
WORKDIR /workspace/chat
USER 1000:1000
CMD ["sleep", "infinity"]

# A short-lived, pids-limited execution sandbox: host preflight and exit status
# are its readiness/completion contract. Periodic processes consume its 8-PID
# budget and may run while the sandbox is paused for snapshot, so disable them.
HEALTHCHECK NONE
